# Sprix Hiring Management Platform — Production Configuration

# Shared Password for Recruiter Access (set in .env.local or Vercel Environment Variables)
APP_PASSWORD=your_secure_password_here

# Supabase Central Persistent Database (Required for cross-device persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Google Apps Script Web App Endpoint (Deployed as Web App with access: Anyone)
GOOGLE_APPS_SCRIPT_URL=

# Google Sheet ID (Spreadsheet containing Form responses)
GOOGLE_SHEET_ID=1E_WrVvh4LBCM60tfLjL3gx1QLw4LLPy1nA60mirzUKQ

# Google Form ID
GOOGLE_FORM_ID=
